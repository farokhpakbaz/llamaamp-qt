[Desktop Entry]
Type=Application
Name=LlamaAmp Qt
Comment=Play and manage your music
Exec=llamaamp %U
Icon=io.github.farokhpakbaz.LlamaAmp
Terminal=false
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/ogg;audio/flac;audio/x-wav;audio/mp4;audio/aac;video/mp4;video/x-matroska;video/webm;application/vnd.apple.mpegurl;audio/x-mpegurl;
StartupWMClass=llamaamp
